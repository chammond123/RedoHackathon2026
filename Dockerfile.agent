# ── Python Agent Container ────────────────────────────────
FROM python:3.13-slim AS agent

WORKDIR /app

# System deps for potential git/build operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY pyproject.toml ./
COPY src/ src/
RUN pip install --no-cache-dir -e ".[dev]" && \
    pip install --no-cache-dir fastapi uvicorn[standard] python-dotenv

# Expose internal-only port
EXPOSE 8000

CMD ["uvicorn", "bugfixer.server:app", "--host", "0.0.0.0", "--port", "8000"]
